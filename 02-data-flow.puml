@startuml OASIS-X Data Flow
!theme plain
skinparam backgroundColor #0B0F19
skinparam activity {
  BackgroundColor #1A2232
  BorderColor #FF9E00
  FontColor #e0f0ff
}
skinparam arrow {
  Color #FF9E00
  FontColor #8899b3
}
skinparam partition {
  BackgroundColor rgba(255,158,0,0.04)
  BorderColor #FF9E00
  FontColor #FF9E00
}

|Pipeline|
start
:Generate Telemetry\ndata_simulator.py;
:Apply NCC Drift\nncc_feed.py (Harmattan/Rain);
:Detect Anomalies\nanomaly_detector.py (IsolationForest);
:Classify State\ndecision_engine.py;
:Diagnose & Recommend\nllm_agent.py OR rule fallback;
stop

|Side Processes|
partition Chat {
  :User sends message;
  :Ollama processes;
  :Mode filter (Technical/Simple);
  :Display reply;
}

partition Summary {
  :Pipeline completes;
  :generate_4line_summary();
  :LLM or rule engine fallback;
  :Update summary card;
}

partition FaultInjection {
  :Click fault button;
  :digital_twin.inject_fault();
  :Run pipeline on affected row;
  :Update dashboard;
}

|Persistence|
partition Database {
  :pipeline_runs - metadata;
  :telemetry_rows - readings;
  :diagnosis_logs - results;
  :chat_messages - conversations;
  :users + user_profiles - auth & settings;
  :activity_logs - audit trail;
  :complaints + complaint_messages - support;
}

|ErrorHandling|
partition "Error Handling & Fallbacks" {
  :LLM Unavailable → Rule-based diagnosis;
  :Stream Error → Graceful None return;
  :Cold Start (65-232s) → 180s timeout;
}

@enduml
