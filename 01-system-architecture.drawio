            </mxCell>
            
            <!-- Arrows -->
            <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3b82f6;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;targetPerimeterSpacing=4;" parent="1" source="browser" target="fastapi" edge="1"/>
            <mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3b82f6;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;targetPerimeterSpacing=4;" parent="1" source="desktop" target="core" edge="1"/>
            <mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF9E00;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;targetPerimeterSpacing=4;" parent="1" source="fastapi" target="core" edge="1"/>
            <mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#00c862;strokeWidth=2;exitX=0.3;exitY=1;entryX=0.3;entryY=0;targetPerimeterSpacing=4;" parent="1" source="core" target="db" edge="1"/>
            <mxCell id="a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#00c862;strokeWidth=2;exitX=0.7;exitY=1;entryX=0.5;entryY=0;targetPerimeterSpacing=4;" parent="1" source="core" target="ml" edge="1"/>
            <mxCell id="a6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#a855f7;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;targetPerimeterSpacing=4;" parent="1" source="core" target="ollama" edge="1"/>
        </root>
