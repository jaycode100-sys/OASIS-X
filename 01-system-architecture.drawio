<mxfile>
<diagram name="OASIS-X System Architecture" id="arch">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10">
        <root>
            <mxCell id="0"/>
            <mxCell id="1" parent="0"/>
            
            <!-- Client Layer -->
            <mxCell id="bg1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B0F19;strokeColor=#3b82f6;strokeWidth=2;dashed=1;opacity=50;" parent="1" vertex="1">
                <mxGeometry x="40" y="40" width="520" height="140" as="geometry"/>
            </mxCell>
            <mxCell id="cl-title" value="&lt;b&gt;CLIENT LAYER&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#3b82f6;fontSize=11;" parent="1" vertex="1">
                <mxGeometry x="50" y="45" width="200" height="20" as="geometry"/>
            </mxCell>
            
            <mxCell id="browser" value="&lt;b&gt;Web Browser&lt;/b&gt;&lt;hr&gt;Dashboard (index.html)&lt;br&gt;Login Page (login.html)&lt;br&gt;Chart.js Visualizations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A2232;strokeColor=#3b82f6;strokeWidth=2;fontColor=#e0f0ff;fontSize=10;" parent="1" vertex="1">
                <mxGeometry x="70" y="70" width="200" height="90" as="geometry"/>
            </mxCell>
            
            <mxCell id="desktop" value="&lt;b&gt;Desktop App&lt;/b&gt;&lt;hr&gt;PyWebView Native Window&lt;br&gt;Fallback to Browser&lt;br&gt;Background Uvicorn Thread" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A2232;strokeColor=#3b82f6;strokeWidth=2;fontColor=#e0f0ff;fontSize=10;" parent="1" vertex="1">
                <mxGeometry x="330" y="70" width="200" height="90" as="geometry"/>
            </mxCell>
            
            <!-- Server Layer -->
            <mxCell id="bg2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B0F19;strokeColor=#FF9E00;strokeWidth=2;dashed=1;opacity=50;" parent="1" vertex="1">
                <mxGeometry x="40" y="200" width="520" height="140" as="geometry"/>
            </mxCell>
            <mxCell id="sv-title" value="&lt;b&gt;SERVER LAYER&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#FF9E00;fontSize=11;" parent="1" vertex="1">
                <mxGeometry x="50" y="205" width="200" height="20" as="geometry"/>
            </mxCell>
            
            <mxCell id="fastapi" value="&lt;b&gt;FastAPI Web Server&lt;/b&gt;&lt;hr&gt;api/app.py — App Factory&lt;br&gt;api/routes.py — REST Endpoints&lt;br&gt;api/auth.py — Auth (JWT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A2232;strokeColor=#FF9E00;strokeWidth=2;fontColor=#e0f0ff;fontSize=10;" parent="1" vertex="1">
                <mxGeometry x="70" y="225" width="220" height="95" as="geometry"/>
            </mxCell>
            
            <mxCell id="core" value="&lt;b&gt;Core Engine&lt;/b&gt;&lt;hr&gt;decision_engine.py&lt;br&gt;digital_twin.py&lt;br&gt;chat_agent.py / llm_agent.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A2232;strokeColor=#FF9E00;strokeWidth=2;fontColor=#e0f0ff;fontSize=10;" parent="1" vertex="1">
                <mxGeometry x="310" y="225" width="220" height="95" as="geometry"/>
            </mxCell>
            
            <!-- Data Layer -->
            <mxCell id="bg3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B0F19;strokeColor=#00c862;strokeWidth=2;dashed=1;opacity=50;" parent="1" vertex="1">
                <mxGeometry x="40" y="360" width="520" height="140" as="geometry"/>
            </mxCell>
            <mxCell id="dt-title" value="&lt;b&gt;DATA &amp;amp; ML LAYER&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#00c862;fontSize=11;" parent="1" vertex="1">
                <mxGeometry x="50" y="365" width="200" height="20" as="geometry"/>
            </mxCell>
            
            <mxCell id="db" value="&lt;b&gt;SQLite Database&lt;/b&gt;&lt;hr&gt;data/database.py (WAL mode)&lt;br&gt;Tables: users, pipeline_runs,&lt;br&gt;telemetry, diagnosis, chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A2232;strokeColor=#00c862;strokeWidth=2;fontColor=#e0f0ff;fontSize=10;" parent="1" vertex="1">
                <mxGeometry x="70" y="385" width="200" height="95" as="geometry"/>
            </mxCell>
            
            <mxCell id="ml" value="&lt;b&gt;ML / Anomaly Detection&lt;/b&gt;&lt;hr&gt;IsolationForest (sklearn)&lt;br&gt;models/anomaly_detector.py&lt;br&gt;models/ncc_feed.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A2232;strokeColor=#00c862;strokeWidth=2;fontColor=#e0f0ff;fontSize=10;" parent="1" vertex="1">
                <mxGeometry x="310" y="385" width="220" height="95" as="geometry"/>
            </mxCell>
            
            <!-- External Layer -->
            <mxCell id="bg4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0B0F19;strokeColor=#a855f7;strokeWidth=2;dashed=1;opacity=50;" parent="1" vertex="1">
                <mxGeometry x="40" y="520" width="520" height="80" as="geometry"/>
            </mxCell>
            <mxCell id="ex-title" value="&lt;b&gt;EXTERNAL / INFRA&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#a855f7;fontSize=11;" parent="1" vertex="1">
