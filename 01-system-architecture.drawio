            </mxCell>
            
            <mxCell id="ollama" value="&lt;b&gt;Ollama LLM&lt;/b&gt;&lt;br&gt;swift-fhs / nexus-chat / llama3.2:1b" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A2232;strokeColor=#a855f7;strokeWidth=2;fontColor=#a855f7;fontSize=10;" parent="1" vertex="1">
                <mxGeometry x="70" y="540" width="200" height="40" as="geometry"/>
            </mxCell>
            
            <mxCell id="railway" value="&lt;b&gt;Railway Cloud&lt;/b&gt;&lt;br&gt;Nixpacks Deploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A2232;strokeColor=#a855f7;strokeWidth=2;fontColor=#a855f7;fontSize=10;" parent="1" vertex="1">
