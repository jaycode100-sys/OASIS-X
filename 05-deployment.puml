@startuml OASIS-X Deployment
!theme plain
skinparam backgroundColor #0B0F19
skinparam node {
  BackgroundColor #1A2232
  BorderColor #FF9E00
  FontColor #e0f0ff
}
skinparam component {
  BackgroundColor #121824
  BorderColor #3b82f6
  FontColor #e0f0ff
}
skinparam artifact {
  BackgroundColor #1A2232
  BorderColor #00c862
  FontColor #00c862
}
skinparam package {
  BackgroundColor rgba(0,0,0,0)
  BorderColor #3b82f6
  FontColor #3b82f6
}

package "COMMON CODEBASE" as Common {
  artifact "api/ — FastAPI REST endpoints + Auth" as api
  artifact "root/ — Decision engine, digital twin, LLM agents" as root
  artifact "models/ — Data sim, NCC feed, anomaly detector" as models
  artifact "static/ — Dashboard HTML, CSS, JS" as static
  artifact "data/ — SQLite DB layer" as data
}

node "DEVELOPMENT" as Dev {
  component "Local Machine (Windows)" {
    component "Python 3.11+ / FastAPI / Uvicorn" as py
    component "SQLite (local file)" as sqlite
    component "Ollama Server (localhost:11434)" as ollama
    component "3 LLM Models:\nswift-fhs, nexus-chat, llama3.2:1b" as models3
    component "Pip install - requirements.txt" as pip
    component "Chart.js (CDN)" as chart
  }
  api --> py
  root --> py
  models --> py
  static --> py
  data --> sqlite
  py --> ollama : HTTP
  ollama --> models3
}

node "RAILWAY (PRODUCTION)" as Rail {
  component "Nixpacks Build (Python 3.11)" as nix
  component "No Ollama → Rule Fallback" as noollama
  component "$PORT env var binding" as port
  component "Persistent Volume for data/" as vol
  component "OASIS_SECRET_KEY (JWT)" as key
  component "healthcheck: /api/status" as hc
  component "start: uvicorn api.app:app" as start
  api --> nix
  root --> nix
  models --> nix
  data --> vol
  nix --> port
  nix --> key
  nix --> hc
  nix --> noollama
}

node "DESKTOP (STANDALONE)" as Desk {
  component "PyInstaller Build (build_desktop.py)" as build
  component "desktop_app.py:\nUvicorn thread + PyWebView" as runtime
  component "Native Window (MS Edge WebView2)" as webview
  component "Fallback: auto-open browser tab" as fallback
  component "Bundled: static/, models/" as bundled
  component "Output: dist/OASIS-X/OASIS-X.exe" as exe
  api --> build
  root --> build
  models --> build
  runtime --> webview
  runtime --> fallback
  build --> exe
}

@enduml
