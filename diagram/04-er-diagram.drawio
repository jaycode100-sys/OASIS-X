<?xml version="1.0" encoding="UTF-8"?>
<mxfile>
<diagram name="OASIS-X ER Diagram" id="er">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10">
        <root>
            <mxCell id="0"/>
            <mxCell id="1" parent="0"/>
            
            <!-- users -->
            <mxCell id="users" value="&lt;b&gt;users&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#00c862&quot;&gt;id (PK)&lt;/font&gt; INTEGER&lt;br&gt;&lt;font color=&quot;#FF9E00&quot;&gt;username&lt;/font&gt; TEXT UNIQUE&lt;br&gt;hashed_password TEXT&lt;br&gt;role TEXT [default 'user']&lt;br&gt;created_at TEXT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A2232;strokeColor=#FF9E00;strokeWidth=2;fontColor=#e0f0ff;fontSize=10;" parent="1" vertex="1">
                <mxGeometry x="50" y="50" width="220" height="100" as="geometry"/>
            </mxCell>
            
            <!-- user_profiles -->
            <mxCell id="profiles" value="&lt;b&gt;user_profiles&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#00c862&quot;&gt;id (PK)&lt;/font&gt; INTEGER&lt;br&gt;&lt;font color=&quot;#3b82f6&quot;&gt;user_id (FK)&lt;/font&gt; INTEGER UNIQUE&lt;br&gt;display_name TEXT&lt;br&gt;avatar_color TEXT&lt;br&gt;theme TEXT [default 'dark']&lt;br&gt;settings_json TEXT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A2232;strokeColor=#00c862;strokeWidth=2;fontColor=#e0f0ff;fontSize=10;" parent="1" vertex="1">
                <mxGeometry x="50" y="200" width="220" height="120" as="geometry"/>
            </mxCell>
            
            <!-- pipeline_runs -->
            <mxCell id="runs" value="&lt;b&gt;pipeline_runs&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#00c862&quot;&gt;id (PK)&lt;/font&gt; INTEGER&lt;br&gt;user_id INTEGER&lt;br&gt;created_at TEXT&lt;br&gt;city TEXT&lt;br&gt;season TEXT&lt;br&gt;n_samples INTEGER&lt;br&gt;summary_json TEXT&lt;br&gt;ncc_compliance_json TEXT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A2232;strokeColor=#3b82f6;strokeWidth=2;fontColor=#e0f0ff;fontSize=10;" parent="1" vertex="1">
                <mxGeometry x="50" y="380" width="220" height="150" as="geometry"/>
            </mxCell>
            
            <!-- telemetry_rows -->
            <mxCell id="telemetry" value="&lt;b&gt;telemetry_rows&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#00c862&quot;&gt;id (PK)&lt;/font&gt; INTEGER&lt;br&gt;&lt;font color=&quot;#3b82f6&quot;&gt;run_id (FK)&lt;/font&gt; INTEGER&lt;br&gt;row_index INTEGER&lt;br&gt;row_data_json TEXT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A2232;strokeColor=#3b82f6;strokeWidth=2;fontColor=#e0f0ff;fontSize=10;" parent="1" vertex="1">
                <mxGeometry x="50" y="580" width="220" height="90" as="geometry"/>
            </mxCell>
            
            <!-- diagnosis_logs -->
            <mxCell id="diag" value="&lt;b&gt;diagnosis_logs&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#00c862&quot;&gt;id (PK)&lt;/font&gt; INTEGER&lt;br&gt;user_id INTEGER&lt;br&gt;run_id (FK) INTEGER&lt;br&gt;row_index INTEGER&lt;br&gt;diagnosis_json TEXT&lt;br&gt;source TEXT&lt;br&gt;created_at TEXT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A2232;strokeColor=#a855f7;strokeWidth=2;fontColor=#e0f0ff;fontSize=10;" parent="1" vertex="1">
                <mxGeometry x="380" y="50" width="220" height="130" as="geometry"/>
            </mxCell>
            
            <!-- chat_messages -->
            <mxCell id="chat" value="&lt;b&gt;chat_messages&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#00c862&quot;&gt;id (PK)&lt;/font&gt; INTEGER&lt;br&gt;role TEXT&lt;br&gt;content TEXT&lt;br&gt;created_at TEXT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A2232;strokeColor=#f97316;strokeWidth=2;fontColor=#e0f0ff;fontSize=10;" parent="1" vertex="1">
                <mxGeometry x="380" y="230" width="220" height="90" as="geometry"/>
            </mxCell>
            
            <!-- activity_logs -->
            <mxCell id="activity" value="&lt;b&gt;activity_logs&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#00c862&quot;&gt;id (PK)&lt;/font&gt; INTEGER&lt;br&gt;type TEXT&lt;br&gt;message TEXT&lt;br&gt;html TEXT&lt;br&gt;user_id INTEGER&lt;br&gt;username TEXT&lt;br&gt;user_agent TEXT&lt;br&gt;created_at TEXT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A2232;strokeColor=#ef4444;strokeWidth=2;fontColor=#e0f0ff;fontSize=10;" parent="1" vertex="1">
                <mxGeometry x="380" y="370" width="220" height="150" as="geometry"/>
            </mxCell>
            
            <!-- complaints -->
            <mxCell id="complaints" value="&lt;b&gt;complaints&lt;/b&gt;&lt;hr&gt;&lt;font color=&quot;#00c862&quot;&gt;id (PK)&lt;/font&gt; INTEGER&lt;br&gt;&lt;font color=&quot;#3b82f6&quot;&gt;user_id (FK)&lt;/font&gt; INTEGER&lt;br&gt;subject TEXT&lt;br&gt;status TEXT [default 'open']&lt;br&gt;assigned_to (FK) INTEGER&lt;br&gt;created_at TEXT&lt;br&gt;updated_at TEXT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A2232;strokeColor=#06b6d4;strokeWidth=2;fontColor=#e0f0ff;fontSize=10;" parent="1" vertex="1">
                <mxGeometry x="380" y="570" width="220" height="140" as="geometry"/>
            </mxCell>
            
            <!-- Relations -->
            <mxCell id="r1" value="1:1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#8899b3;fontSize=9;" parent="1" vertex="1" connectable="0">
                <mxGeometry x="160" y="175" as="geometry"/>
            </mxCell>
            <mxCell id="r2" value="1:N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#8899b3;fontSize=9;" parent="1" vertex="1" connectable="0">
                <mxGeometry x="160" y="360" as="geometry"/>
            </mxCell>
            <mxCell id="r3" value="1:N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#8899b3;fontSize=9;" parent="1" vertex="1" connectable="0">
                <mxGeometry x="160" y="560" as="geometry"/>
            </mxCell>
        </root>
    </mxGraphModel>
</diagram>
</mxfile>
