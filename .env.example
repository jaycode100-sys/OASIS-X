# ── Server ──────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0

# ── Authentication ──────────────────────────────────────────────────────
# REQUIRED: Change this to a long random string in production.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
OASIS_SECRET_KEY=change-me-to-a-random-secret-key
OASIS_ALGORITHM=HS256
OASIS_TOKEN_EXPIRY_HOURS=24

# ── Database ────────────────────────────────────────────────────────────
# Leave empty to use %APPDATA%/OASIS-X (Windows) or data/ (Linux)
# OASIS_DB_DIR=
# OASIS_DB_PATH=

# ── Ollama LLM ──────────────────────────────────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_TIMEOUT=180
# SWIFT_LLM_MODEL=swift-fhs
# CHAT_MODEL=nexus-chat

# ── Logging ─────────────────────────────────────────────────────────────
# LOG_LEVEL=info
