# ── Server ──────────────────────────────────────────────────────────────
# Railway sets $PORT automatically. Fallback is 8080 for local dev.
# PORT=8080
# HOST=0.0.0.0

# ── Authentication ──────────────────────────────────────────────────────
# REQUIRED: Change this to a long random string in production.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
OASIS_SECRET_KEY=change-me-to-a-random-secret-key

# ── Ollama LLM ──────────────────────────────────────────────────────────
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_TIMEOUT=120
# SWIFT_LLM_MODEL=swift-fhs

# ── Database ────────────────────────────────────────────────────────────
# OASIS_DB_DIR=data
# OASIS_DB_PATH=data/oasis.db

# ── Chat ────────────────────────────────────────────────────────────────
# CHAT_MODEL=nexus-chat
