# ── Server ─────────────────────────────────────────────────────────────────────
# Port (Railway sets this automatically via $PORT; fallback is 8080)
# PORT=8080
# Host to bind to (default: 0.0.0.0)
# HOST=0.0.0.0

# ── Authentication ─────────────────────────────────────────────────────────────
# JWT signing key — CHANGE THIS in production to a long random string
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
OASIS_SECRET_KEY=change-me-to-a-random-secret-key

# ── Ollama LLM ─────────────────────────────────────────────────────────────────
# URL of the Ollama server (can be a remote Railway service or external host)
# OLLAMA_BASE_URL=http://localhost:11434
# LLM model name for diagnosis (default: swift-fhs)
# SWIFT_LLM_MODEL=swift-fhs
# Timeout in seconds for Ollama API calls (default: 120)
# OLLAMA_TIMEOUT=120

# ── Database ───────────────────────────────────────────────────────────────────
# Directory for the SQLite database file (default: ./data/)
# OASIS_DB_DIR=data
# Full path to the SQLite database file (overrides OASIS_DB_DIR)
# OASIS_DB_PATH=data/oasis.db

# ── Chat Agent ─────────────────────────────────────────────────────────────────
# Chat model name for Nexus chat (default: nexus-chat)
# CHAT_MODEL=nexus-chat
