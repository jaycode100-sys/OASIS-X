@startuml OASIS-X Component Structure
!theme plain
skinparam backgroundColor #0B0F19
skinparam package {
  BackgroundColor rgba(0,0,0,0)
  BorderColor #FF9E00
  FontColor #FF9E00
}
skinparam rectangle {
  BackgroundColor #1A2232
  BorderColor #FF9E00
  FontColor #e0f0ff
}
skinparam database {
  BackgroundColor #121824
  BorderColor #00c862
  FontColor #00c862
}

package "api/ — FastAPI REST Layer" {
  [app.py] as app : FastAPI app factory\nStatic mount, CORS\nStartup init
  [routes.py] as routes : REST endpoints\nPipeline, diagnose, chat\nProfile, complaints, activity
  [auth.py] as auth : JWT login/register\nbcrypt password hashing\nRole-based access
  [schemas.py] as schemas : Pydantic models\nLoginRequest, TokenResponse\nUserResponse
}

package "root/ — Core Engine Layer" {
  [decision_engine.py] as de : Classify NORMAL/DEGRADING/CRITICAL\nRisk scores, healing recommendations
  [digital_twin.py] as dt : FibreDigitalTwin (NetworkX)\nTopology, fault injection\nHealing actions
  [llm_agent.py] as llm : LLM diagnosis agent\nOllama availability check\nTelemetry prompts, fallback
  [chat_agent.py] as chat : Nexus chat\nStreaming token-by-token\nTechnical/Simple modes
}

package "models/ — Data & ML Layer" {
  [data_simulator.py] as ds : Nigerian telemetry\nTime-of-day, harmattan/rain\nCuts, degradation
  [ncc_feed.py] as ncc : NCC baselines, QoS thresholds\nDrift simulation, season detection
  [anomaly_detector.py] as ad : IsolationForest training\nFeature engineering\nAnomaly scoring
}

database "data/ — Persistence Layer" {
  [database.py] as db : SQLite CRUD\ninit_db, save/query\nPipeline, users, profiles\nComplaints, activity, chat
}

package "Top-Level Entry Points" {
  [start_server.py] as start : Uvicorn runner\nPort/Host config
  [desktop_app.py] as desk : PyWebView + Background\nUvicorn thread
  [build_desktop.py] as build : PyInstaller bundle\n-> OASIS-X.exe
}

app -down-> routes : includes
app -down-> auth : includes
routes -down-> de : calls
routes -down-> llm : calls
routes -down-> chat : calls
de -down-> dt : uses
de -down-> ncc : uses
llm -down-> ad : uses
ds -down-> ncc : feeds
routes -down-> db : persists

@enduml
